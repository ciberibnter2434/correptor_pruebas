import streamlit as st
import pandas as pd

st.set_page_config(page_title="Corrector de Pruebas", layout="centered")
st.title("📝 Corrector Automatizado de Pruebas")

# 1. Configuración de la prueba
st.sidebar.header("⚙️ Configuración")
total_preguntas = st.sidebar.number_input("Número total de preguntas", min_value=1, value=10)
exigencia = st.sidebar.slider("Porcentaje de exigencia (%)", 50, 70, 60) / 100
nota_maxima = st.sidebar.number_input("Nota Máxima", min_value=1.0, value=7.0, step=0.1)
nota_minima = st.sidebar.number_input("Nota Mínima", min_value=1.0, value=1.0, step=0.1)
nota_aprobacion = st.sidebar.number_input("Nota de Aprobación", min_value=1.0, value=4.0, step=0.1)

# 2. Ingreso de la Pauta Correcta
st.header("1. Clave de Respuestas Correctas (Pauta)")
pauta_input = st.text_input("Ingresa las respuestas correctas separadas por comas (Ej: A,B,C,A,D):")
pauta = [r.strip().upper() for r in pauta_input.split(",") if r.strip()]

if len(pauta) == total_preguntas:
    st.success("✅ Pauta ingresada correctamente.")
    
    # 3. Carga de respuestas de alumnos
    st.header("2. Cargar Respuestas de Alumnos")
    uploaded_file = st.file_uploader("Sube un archivo Excel (.xlsx) o CSV con las respuestas", type=["xlsx", "csv"])
    
    if uploaded_file:
        # Leer archivo
        if uploaded_file.name.endswith('.csv'):
            df = pd.read_csv(uploaded_file)
        else:
            df = pd.read_excel(uploaded_file)
            
        st.write("Visualización de datos cargados:", df.head())
        
        # El archivo debe tener columnas: "Alumno" y las preguntas (ej: "P1", "P2"...)
        if st.button("📊 Corregir y Calcular Notas"):
            resultados = []
            columnas_preguntas = [col for col in df.columns if col.upper() != "ALUMNO"]
            
            for index, row in df.iterrows():
                alumno = row["Alumno"]
                puntaje = 0
                
                # Comparar respuestas
                for i, col in enumerate(columnas_preguntas):
                    if i < len(pauta) and str(row[col]).strip().upper() == pauta[i]:
                        puntaje += 1
                
                # Calcular nota (Escala lineal con porcentaje de exigencia)
                puntaje_corte = total_preguntas * exigencia
                if puntaje < puntaje_corte:
                    nota = nota_minima + (nota_aprobacion - nota_minima) * (puntaje / puntaje_corte)
                else:
                    nota = nota_aprobacion + (nota_maxima - nota_aprobacion) * ((puntaje - puntaje_corte) / (total_preguntas - puntaje_corte))
                
                resultados.append({
                    "Alumno": alumno,
                    "Puntaje": puntaje,
                    "Nota": round(nota, 1),
                    "Estado": "Aprobado" if nota >= nota_aprobacion else "Reprobado"
                })
            
            df_final = pd.DataFrame(resultados)
            st.header("🏆 Resultados Finales")
            st.dataframe(df_final)
            
            # Descargar resultados
            csv = df_final.to_csv(index=False).encode('utf-8')
            st.download_button("📥 Descargar Excel de Notas", data=csv, file_name="notas_corregidas.csv", mime="text/csv")
else:
    st.warning(f"⚠️ Por favor, ingresa exactamente {total_preguntas} respuestas en la pauta (llevas {len(pauta)}).")
